---
// 暗記カードの小さな実物。問題はこの年表そのものから作った3枚
const cards = [
  { q: 'この年表でいちばん最初に作ったものは？', a: 'クイズ得点板（4月11日）' },
  { q: '1日に3つ作った日は何月何日？', a: '10月19日' },
  { q: '動物園・水族館ログに入っている施設の数は？', a: '473施設' },
];
---
<div class="fc" data-fc>
  <div class="fc__stage">
    <button type="button" class="fc__card" data-card aria-describedby="fc-hint">
      <span class="fc__face fc__face--q"><span class="fc__tag">Q</span><span data-q>{cards[0].q}</span></span>
      <span class="fc__face fc__face--a"><span class="fc__tag">A</span><span data-a>{cards[0].a}</span></span>
    </button>
  </div>
  <p class="fc__hint" id="fc-hint">カードを押すと答えが出ます</p>
  <div class="fc__nav">
    <span class="fc__count" data-count>1 / {cards.length}</span>
    <button type="button" class="fc__next" data-next>次のカード</button>
  </div>
  <script type="application/json" data-cards set:html={JSON.stringify(cards)} />
</div>

<style>
  .fc__stage {
    perspective: 900px;
  }

  .fc__card {
    position: relative;
    display: block;
    width: 100%;
    min-height: 150px;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    transform-style: preserve-3d;
    transition: transform 520ms cubic-bezier(0.3, 0.7, 0.2, 1);
  }

  .fc__card[aria-pressed='true'] {
    transform: rotateY(180deg);
  }

  .fc__face {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 20px;
    border-radius: 8px;
    background: #fff;
    box-shadow: inset 0 0 0 1px var(--rule), 0 3px 8px -4px rgb(38 43 53 / 0.3);
    font-size: 17px;
    line-height: 1.6;
    backface-visibility: hidden;
  }

  .fc__face--a {
    transform: rotateY(180deg);
    color: #c53f35;
    font-weight: 700;
  }

  .fc__tag {
    flex: none;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #2e7382;
    color: #fff;
    font-weight: 700;
  }

  .fc__face--a .fc__tag {
    background: #c53f35;
  }

  .fc__hint {
    margin: 8px 0 0;
    color: var(--ink-soft);
    font-size: 13px;
  }

  .fc__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 12px;
  }

  .fc__count {
    font-family: var(--num);
    font-weight: 500;
  }

  .fc__next {
    padding: 8px 16px;
    border: 0;
    border-radius: 999px;
    background: #2e7382;
    color: #fff;
    font: inherit;
    font-size: 14px;
    cursor: pointer;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-fc]').forEach((root) => {
    const cards: { q: string; a: string }[] = JSON.parse(root.querySelector('[data-cards]')!.textContent!);
    const card = root.querySelector<HTMLButtonElement>('[data-card]')!;
    const q = root.querySelector('[data-q]')!;
    const a = root.querySelector('[data-a]')!;
    const count = root.querySelector('[data-count]')!;
    let i = 0;
    card.setAttribute('aria-pressed', 'false');

    card.addEventListener('click', () => {
      card.setAttribute('aria-pressed', String(card.getAttribute('aria-pressed') !== 'true'));
    });

    root.querySelector('[data-next]')!.addEventListener('click', () => {
      const flipped = card.getAttribute('aria-pressed') === 'true';
      const swap = () => {
        i = (i + 1) % cards.length;
        q.textContent = cards[i].q;
        a.textContent = cards[i].a;
        count.textContent = `${i + 1} / ${cards.length}`;
      };
      // 答えが出たままなら、表に戻ってから中身を替える（裏の答えが先に見えないように）
      if (flipped) {
        card.setAttribute('aria-pressed', 'false');
        setTimeout(swap, 260);
      } else {
        swap();
      }
    });
  });
</script>
