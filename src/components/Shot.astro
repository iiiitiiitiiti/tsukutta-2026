---
// スクショ1枚。public/shots/<id>.webp があれば写真として出し、無ければ準備中の紙を置く
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';

interface Props {
  id: string;
  alt: string;
  tilt?: number;
}
const { id, alt, tilt = 1 } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const hasWebp = existsSync(resolve(process.cwd(), 'public/shots', `${id}.webp`));
const hasAvif = existsSync(resolve(process.cwd(), 'public/shots', `${id}.avif`));
---
<figure class="shot" style={`--shot-tilt: ${tilt}deg`}>
  <div class="shot__frame">
    {hasWebp ? (
      <picture>
        {hasAvif && <source srcset={`${base}/shots/${id}.avif`} type="image/avif" />}
        <img src={`${base}/shots/${id}.webp`} alt={alt} loading="lazy" decoding="async" />
      </picture>
    ) : (
      <div class="shot__empty">画像を準備中</div>
    )}
  </div>
  <figcaption class="shot__caption">{alt}</figcaption>
</figure>
