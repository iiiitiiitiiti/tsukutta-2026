---
// 各ツールの小さな実物。extras.json の demo の値で出し分ける
import Scoreboard from './demos/Scoreboard.astro';
import Flashcards from './demos/Flashcards.astro';
import Kaimono from './demos/Kaimono.astro';

interface Props {
  kind: string;
}
const { kind } = Astro.props;
const demos: Record<string, any> = { scoreboard: Scoreboard, flashcards: Flashcards, kaimono: Kaimono };
const Component = demos[kind];
---
{Component && (
  <div class="demo">
    <p class="demo__label">さわってみる</p>
    <Component />
  </div>
)}

<style>
  .demo {
    padding: 16px;
    border-radius: 14px;
    background: var(--surface);
    box-shadow: 0 0 0 1px var(--rule);
    text-align: left;
  }

  .demo__label {
    margin: 0 0 12px;
    color: var(--ci);
    font-size: 14px;
    font-weight: 700;
  }
</style>
