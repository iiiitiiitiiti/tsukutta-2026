---
// 手帳の月のツメ。4月から11月まで並べ、作ったものが無い月は押せない形で残す
interface Props {
  months: number[];
}
const { months } = Astro.props;
const all = [4, 5, 6, 7, 8, 9, 10, 11];
---
<nav class="tabs" aria-label="月ごとに移動">
  <p class="tabs__now" aria-hidden="true"><span class="tabs__now-num" data-now>4</span>月</p>
  <ol class="tabs__list">
    {all.map((m) =>
      months.includes(m) ? (
        <li><a class="tabs__tab" href={`#m${m}`} data-month={m}>{m}<span class="sr-only">月</span></a></li>
      ) : (
        <li><span class="tabs__tab tabs__tab--empty" title={`${m}月は作ったものが無い`}>{m}<span class="sr-only">月（作ったものは無し）</span></span></li>
      ),
    )}
  </ol>
</nav>

<style>
  .tabs {
    position: fixed;
    top: 50%;
    right: 0;
    z-index: 10;
    translate: 0 -50%;
    display: grid;
    justify-items: end;
    gap: 10px;
  }

  /* 今読んでいる月。数字が上下にめくれて替わる */
  .tabs__now {
    margin: 0 6px 0 0;
    font-family: var(--hand);
    font-size: 13px;
    font-weight: 600;
    line-height: 1;
    color: var(--stamp);
    perspective: 200px;
  }

  .tabs__now-num {
    display: inline-block;
    min-width: 1.4em;
    font-size: 26px;
    text-align: right;
    transform-origin: 50% 50%;
  }

  .tabs__list {
    display: grid;
    gap: 3px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tabs__tab {
    display: grid;
    place-items: center;
    width: 36px;
    height: 34px;
    border-radius: 8px 0 0 8px;
    background: #fff;
    box-shadow: inset 0 0 0 1px var(--rule);
    color: var(--ink);
    font-family: var(--hand);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    translate: 0 0;
    transition: width 260ms cubic-bezier(0.2, 0.8, 0.2, 1), background-color 260ms, color 260ms;
  }

  a.tabs__tab:hover {
    width: 42px;
  }

  .tabs__tab[aria-current='true'] {
    width: 52px;
    background: var(--stamp);
    box-shadow: none;
    color: #fff;
  }

  .tabs__tab--empty {
    color: #9aa1ad;
    background: transparent;
    box-shadow: inset 0 0 0 1px rgb(201 212 220 / 0.6);
  }

  @media (min-width: 768px) {
    .tabs__tab {
      width: 44px;
      height: 40px;
      font-size: 17px;
    }

    a.tabs__tab:hover {
      width: 52px;
    }

    .tabs__tab[aria-current='true'] {
      width: 64px;
    }
  }
</style>

<script>
  // 紙の色は月ごとに替える。4月の若葉色から11月の枯葉色へ
  const tints: Record<number, string> = {
    4: '#eef5e8',
    7: '#e7f2f4',
    8: '#f3f1e2',
    9: '#efedf5',
    10: '#f6ede3',
    11: '#f1e9df',
  };
  const tabs = new Map<number, HTMLElement>();
  document.querySelectorAll<HTMLElement>('.tabs__tab[data-month]').forEach((el) => tabs.set(Number(el.dataset.month), el));
  const now = document.querySelector<HTMLElement>('[data-now]');
  let current = 0;

  function show(month: number) {
    if (month === current) return;
    const down = month > current;
    current = month;
    tabs.forEach((el, m) => el.setAttribute('aria-current', String(m === month)));
    document.documentElement.style.setProperty('--tint', tints[month] ?? '#f3f6f1');
    if (!now) return;
    // めくる: 半分倒して数字を替え、反対側から起こす
    const out = now.animate([{ transform: 'rotateX(0deg)' }, { transform: `rotateX(${down ? -90 : 90}deg)` }], { duration: 140, easing: 'ease-in' });
    out.onfinish = () => {
      // 速く飛ばして続けて替わったときも、最後に入った月を出す
      now.textContent = String(current);
      now.animate([{ transform: `rotateX(${down ? 90 : -90}deg)` }, { transform: 'rotateX(0deg)' }], { duration: 200, easing: 'ease-out' });
    };
  }

  // 画面の中ほどを横切る細い帯に入った月を「今の月」とする
  const sections = [...document.querySelectorAll<HTMLElement>('.month[data-month]')];
  const observer = new IntersectionObserver(
    (entries) => {
      for (const e of entries) if (e.isIntersecting) show(Number((e.target as HTMLElement).dataset.month));
    },
    { rootMargin: '-45% 0px -54% 0px' },
  );
  sections.forEach((s) => observer.observe(s));
  if (sections[0]) show(Number(sections[0].dataset.month));
</script>
