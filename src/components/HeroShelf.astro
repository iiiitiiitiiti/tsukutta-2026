---
// 表紙の棚。18作のアイコンが作った順に上から落ちてきて、月の列に積み上がる。
// 積み上がった高さがそのまま月ごとの作った数の棒グラフになる。
// アイコンは年表のその項目へ、月の数字はその月の帯へのリンクで、目次も兼ねる。
// 名前は吹き出しにせず、グラフ左上の空いた所に出す。吹き出しだと隣の列のアイコンに重なって読めなくなるため
import { existsSync, readFileSync } from 'node:fs';
import { resolve } from 'node:path';

interface Tool {
  id: string;
  name: string;
  icon?: string;
  month: number;
  day: number;
  anchor: string;
}
interface Props {
  tools: Tool[];
}
const { tools } = Astro.props;
// 4月から、11月か作ったものがある最後の月まで。12月の節を原稿に足せば12月の列も出る
const last = Math.max(11, ...tools.map((t) => t.month));
const months = Array.from({ length: last - 3 }, (_, i) => i + 4);
const max = Math.max(...months.map((m) => tools.filter((t) => t.month === m).length));
const svgOf = (icon?: string) => {
  const p = icon ? resolve(process.cwd(), 'node_modules/lucide-static/icons', `${icon}.svg`) : '';
  return p && existsSync(p) ? readFileSync(p, 'utf8').replace(/<!--[\s\S]*?-->/g, '') : '';
};
---
<nav class="chart" aria-label={`月ごとに作った数。全部で${tools.length}こ`} style={`--max: ${max}; --cols: ${months.length}`} data-chart>
  <p class="chart__caption" aria-hidden="true" data-caption><span class="chart__cap-date" data-cap-date></span><span class="chart__cap-name" data-cap-name></span></p>
  <ol class="chart__cols">
    {months.map((m) => {
      const list = tools.filter((t) => t.month === m);
      return (
        <li class="chart__col" data-month={m} data-empty={list.length === 0}>
          <ol class="chart__stack">
            {list.map((t) => (
              <li class="chart__slot" style={`--i: ${tools.indexOf(t)}; --r: ${((tools.indexOf(t) * 37) % 50) - 25}deg`}>
                <a class="chart__link" href={`#${t.anchor}`} data-date={`${m}.${String(t.day).padStart(2, '0')}`} data-name={t.name}>
                  <span class="chart__icon" aria-hidden="true" set:html={svgOf(t.icon)} />
                  <span class="sr-only">{t.name}（{m}月{t.day}日）</span>
                </a>
              </li>
            ))}
          </ol>
          {list.length > 0 ? (
            <a class="chart__month" href={`#m${m}`}><span class="chart__num">{m}</span><span class="chart__unit">月</span><span class="chart__count">{list.length}</span></a>
          ) : (
            <span class="chart__month"><span class="chart__num">{m}</span><span class="chart__unit">月</span><span class="chart__count">0</span></span>
          )}
        </li>
      );
    })}
  </ol>
</nav>

<style>
  /* 丸の大きさは34pxまで。列が増えて（12月の列など）幅に収まらないときは、列の幅に合わせて小さくする */
  .chart {
    container-type: inline-size;
    --size: min(34px, (100cqi - (var(--cols) - 1) * 4px) / var(--cols));
    --gap: 4px;
    --lift: 10px;
    position: relative;
    width: 100%;
  }

  .chart__cols {
    display: grid;
    grid-template-columns: repeat(var(--cols), 1fr);
    align-items: end;
    gap: 0 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chart__col {
    display: grid;
    justify-items: center;
    gap: 10px;
  }

  /* 下から積む。いちばん多い月の高さで全部の列をそろえる。
     一番下のアイコンは線から --lift だけ浮かせ、指したときの輪も線に掛からないようにする */
  .chart__stack {
    display: flex;
    flex-direction: column-reverse;
    align-items: center;
    gap: var(--gap);
    width: 100%;
    height: calc(var(--max) * var(--size) + (var(--max) - 1) * var(--gap) + var(--lift) + 3px);
    margin: 0;
    padding: 0 0 var(--lift);
    border-bottom: 3px solid var(--rule);
    list-style: none;
  }

  .chart__slot {
    position: relative;
    animation: drop 1000ms both;
    animation-delay: calc(500ms + var(--i) * 110ms);
  }

  /* 指したアイコンの枠が、上や隣のアイコンの下に隠れないよう一番上に出す */
  .chart__slot:hover,
  .chart__slot:focus-within {
    z-index: 3;
  }

  .chart__link {
    position: relative;
    display: block;
    color: var(--ink);
  }

  .chart__icon {
    display: grid;
    place-items: center;
    width: var(--size);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--c);
    transition: scale 200ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .chart__icon :global(svg) {
    width: 50%;
    height: auto;
    stroke-width: 1.75;
  }

  .chart__link:hover .chart__icon,
  .chart__link:focus-visible .chart__icon {
    scale: 1.15;
    box-shadow: 0 0 0 3px var(--bg), 0 0 0 6px var(--ink);
  }

  /* 指した物の名前。グラフの左上は4〜8月の列が低くて空いているので、そこに出す */
  .chart__caption {
    position: absolute;
    top: 0;
    left: 0;
    display: grid;
    gap: 6px;
    max-width: 60%;
    margin: 0;
    text-align: left;
    opacity: 0;
    translate: 0 8px;
    transition: opacity 180ms, translate 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
    pointer-events: none;
  }

  .chart__caption.is-on {
    opacity: 1;
    translate: 0 0;
  }

  .chart__cap-date {
    font-family: var(--num);
    font-size: 22px;
    font-weight: 600;
    line-height: 1;
  }

  .chart__cap-name {
    font-size: 17px;
    font-weight: 700;
    line-height: 1.4;
  }

  .chart__month {
    display: grid;
    justify-items: center;
    color: var(--ink);
    font-family: var(--num);
    line-height: 1;
    text-decoration: none;
  }

  .chart__num {
    font-size: 28px;
    font-weight: 600;
  }

  .chart__unit {
    margin-top: 2px;
    font-family: var(--body);
    font-size: 11px;
    font-weight: 700;
  }

  .chart__count {
    display: grid;
    place-items: center;
    min-width: 28px;
    margin-top: 8px;
    padding: 2px 6px;
    border-radius: 999px;
    background: var(--c);
    font-size: 14px;
    font-weight: 500;
  }

  [data-empty='true'] .chart__month {
    color: var(--ink-soft);
  }

  [data-empty='true'] .chart__count {
    background: var(--empty);
  }

  a.chart__month:hover .chart__num {
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 4px;
  }

  @keyframes drop {
    0% {
      translate: 0 -110vh;
      rotate: var(--r);
      animation-timing-function: cubic-bezier(0.55, 0, 1, 0.45);
    }
    55% {
      translate: 0 0;
      rotate: 0deg;
      animation-timing-function: cubic-bezier(0, 0.55, 0.45, 1);
    }
    72% {
      translate: 0 -18px;
      animation-timing-function: cubic-bezier(0.55, 0, 1, 0.45);
    }
    86% {
      translate: 0 0;
      animation-timing-function: cubic-bezier(0, 0.55, 0.45, 1);
    }
    93% {
      translate: 0 -5px;
      animation-timing-function: cubic-bezier(0.55, 0, 1, 0.45);
    }
    100% {
      translate: 0 0;
      rotate: 0deg;
    }
  }

  @media (min-width: 900px) {
    .chart {
      --size: min(60px, (100cqi - (var(--cols) - 1) * 12px) / var(--cols));
      --gap: 6px;
      --lift: 14px;
    }

    .chart__cols {
      gap: 0 12px;
    }

    .chart__num {
      font-size: 44px;
    }

    .chart__unit {
      font-size: 13px;
    }

    .chart__cap-date {
      font-size: 32px;
    }

    .chart__cap-name {
      font-size: 22px;
    }
  }
</style>

<script>
  for (const chart of document.querySelectorAll<HTMLElement>('[data-chart]')) {
    const cap = chart.querySelector<HTMLElement>('[data-caption]')!;
    const date = chart.querySelector<HTMLElement>('[data-cap-date]')!;
    const name = chart.querySelector<HTMLElement>('[data-cap-name]')!;
    const show = (a: Element | null) => {
      if (!(a instanceof HTMLElement) || !a.dataset.name) return cap.classList.remove('is-on');
      date.textContent = a.dataset.date ?? '';
      name.textContent = a.dataset.name;
      cap.classList.add('is-on');
    };
    for (const a of chart.querySelectorAll('.chart__link')) {
      a.addEventListener('pointerenter', () => show(a));
      a.addEventListener('pointerleave', () => show(chart.querySelector('.chart__link:focus-visible')));
      // マウスで押したときのフォーカスでは出さない。飛んだ後も名前が残ってしまうため
      a.addEventListener('focus', () => a.matches(':focus-visible') && show(a));
      a.addEventListener('blur', () => show(null));
    }
  }
</script>
