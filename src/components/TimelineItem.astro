---
// 年表の1項目。線の上の丸から点線を伸ばし、左右どちらかに日付・名前・一言を置く。
// 日付は月の最初の項目だけ「9.05」と大きく出し、同じ月の2件目からは日だけを小さく出す（月は札と線の色で分かるため）。
// 「くわしく読む」を押すと、原稿の全文・さわれる実物・大きなスクショが開く
import Shot from './Shot.astro';
import Counter from './Counter.astro';
import Demo from './Demo.astro';

type Extra = { id: string; match: string; icon?: string; lead?: string; counter?: { value: string; unit: string }; demo?: string; noShot?: boolean };
interface Props {
  date: string;
  month: number;
  day: number;
  title: string;
  paragraphs: string[];
  tools: Extra[];
  side: 'left' | 'right';
  first: boolean;
  anchor: string;
}
const { month, day, title, paragraphs, tools, side, first, anchor } = Astro.props;
const single = tools.length === 1 ? tools[0] : null;
const counters = tools.filter((t) => t.counter);
const demos = tools.filter((t) => t.demo);
const shots = tools.filter((t) => !t.noShot);

// 原稿の「- 語：説明」が続く所は定義リストに、「- 」だけなら箇条書きにまとめる
type Block = { p: string } | { list: string[] };
const blocks = paragraphs.reduce<Block[]>((acc, line) => {
  if (!line.startsWith('- ')) return [...acc, { p: line }];
  const last = acc.at(-1);
  if (last && 'list' in last) last.list.push(line.slice(2));
  else acc.push({ list: [line.slice(2)] });
  return acc;
}, []);
const pair = (item: string) => {
  const i = item.indexOf('：');
  return i > 0 ? [item.slice(0, i), item.slice(i + 1)] : null;
};
---
<article class="item" id={anchor} data-side={side} data-first={first} data-reveal>
  <span class="item__node" aria-hidden="true"></span>
  <div class="item__card">
    <p class="item__date"><span aria-hidden="true">{first && <><span class="item__m">{month}</span><span class="item__dot">.</span></>}<span class="item__d">{String(day).padStart(2, '0')}</span></span><span class="sr-only">{month}月{day}日</span></p>

    {single ? (
      <div class="item__head">
        <Shot id={single.id} alt={`${single.match}の画面`} variant="thumb" icon={single.icon} />
        <div>
          <h3 class="item__title">{title}</h3>
          {single.lead && <p class="item__lead">{single.lead}</p>}
        </div>
      </div>
    ) : (
      <>
        <h3 class="item__title item__title--multi">{tools.length}つ作った日</h3>
        <ul class="item__tools">
          {tools.map((t) => (
            <li class="item__tool" style="--thumb: 56px">
              <Shot id={t.id} alt={`${t.match}の画面`} variant="thumb" icon={t.icon} />
              <div>
                <p class="item__tool-name">{t.match}</p>
                {t.lead && <p class="item__lead">{t.lead}</p>}
              </div>
            </li>
          ))}
        </ul>
      </>
    )}

    {counters.length > 0 && (
      <div class="item__counters">
        {counters.map((t) => <Counter value={t.counter!.value} unit={t.counter!.unit} label={tools.length > 1 ? t.match : ''} />)}
      </div>
    )}

    <details class="item__more" data-more>
      <summary class="item__summary"><span class="item__open">くわしく読む</span><span class="item__close">閉じる</span></summary>
      <div class="item__body">
        <div class="item__text">
          {blocks.map((b) =>
            'p' in b ? (
              <p>{b.p}</p>
            ) : b.list.every((x) => pair(x)) ? (
              <dl class="item__dl">
                {b.list.map((x) => (
                  <div>
                    <dt>{pair(x)![0]}</dt>
                    <dd>{pair(x)![1]}</dd>
                  </div>
                ))}
              </dl>
            ) : (
              <ul class="item__ul">{b.list.map((x) => <li>{x}</li>)}</ul>
            ),
          )}
        </div>
        {demos.map((t) => <Demo kind={t.demo!} />)}
        {shots.map((t) => <Shot id={t.id} alt={`${t.match}の画面`} variant="full" />)}
      </div>
    </details>
  </div>
</article>

<style>
  .item {
    position: relative;
    padding: 0 0 56px 56px;
  }

  /* 線の上の丸。月の色の帯の上に、白（明るい月は墨）の輪で置く */
  .item__node {
    position: absolute;
    top: 30px;
    left: 14px;
    width: 20px;
    height: 20px;
    border: 4px solid var(--on-c);
    border-radius: 50%;
    background: var(--c);
  }

  .item__card {
    position: relative;
  }

  /* 丸から日付へ伸びる点線 */
  .item__card::before {
    content: '';
    position: absolute;
    top: 39px;
    left: -22px;
    width: 18px;
    border-top: 2px dotted var(--on-c);
    opacity: 0.6;
  }

  .item__date {
    display: flex;
    align-items: baseline;
    margin: 0 0 12px;
    color: var(--on-c);
    font-family: var(--num);
    font-weight: 600;
    line-height: 1;
  }

  .item__m,
  .item__d {
    font-size: 56px;
  }

  .item__dot {
    font-size: 40px;
    padding: 0 2px;
  }

  .item:not([data-first='true']) .item__d {
    font-size: 28px;
  }

  /* 小さい日付の高さに、線の上の丸と点線を合わせる */
  .item:not([data-first='true']) .item__node {
    top: 4px;
  }

  .item:not([data-first='true']) .item__card::before {
    top: 13px;
  }

  .item__head {
    display: flex;
    align-items: center;
    gap: 16px;
    --thumb: 64px;
  }

  .item__head > div,
  .item__tool > div {
    min-width: 0;
  }

  .item__title {
    margin: 0 0 4px;
    font-size: 20px;
    font-weight: 700;
    line-height: 1.45;
    letter-spacing: 0.02em;
  }

  .item__title--multi {
    margin-bottom: 12px;
  }

  .item__lead {
    color: var(--on-c);
    font-size: 14px;
    line-height: 1.7;
    text-wrap: pretty;
  }

  .item__tools {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .item__tool {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .item__tool-name {
    font-weight: 700;
    line-height: 1.5;
  }

  .item__counters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    margin-top: 16px;
  }

  .item__more {
    margin-top: 8px;
  }

  .item__summary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    color: var(--on-c);
    text-underline-offset: 4px;
    font-size: 14px;
    font-weight: 700;
    list-style: none;
    cursor: pointer;
    transition: color 200ms;
  }

  .item__summary::-webkit-details-marker {
    display: none;
  }

  .item__summary::after {
    content: '';
    width: 7px;
    height: 7px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    rotate: 45deg;
    translate: 0 -2px;
    transition: rotate 250ms, translate 250ms;
  }

  .item__summary:hover,
  .item__more[open] .item__summary {
    text-decoration: underline;
  }

  .item__summary:focus-visible {
    outline-color: var(--on-c);
  }

  .item__more[open] .item__summary::after {
    rotate: 225deg;
    translate: 0 2px;
  }

  .item__close,
  .item__more[open] .item__open {
    display: none;
  }

  .item__more[open] .item__close {
    display: inline;
  }

  /* スクロールで画面に入ったら、丸が膨らみ、札が下から上がってくる。
     スクリプトが動かないときに隠れたままにならないよう、隠すのは html に .js が付いたときだけ */
  :global(.js) .item:not(.is-in) .item__node {
    scale: 0;
  }

  :global(.js) .item:not(.is-in) .item__card {
    opacity: 0;
    translate: 0 64px;
  }

  .item__node {
    transition: scale 500ms cubic-bezier(0.34, 1.56, 0.64, 1) 80ms;
  }

  .item__card {
    transition:
      opacity 700ms cubic-bezier(0.2, 0.8, 0.2, 1) 120ms,
      translate 800ms cubic-bezier(0.2, 0.8, 0.2, 1) 120ms;
  }

  /* 全文は白い面にのせて、帯の色の上でも読みやすくする */
  .item__body {
    display: grid;
    gap: 24px;
    margin-top: 8px;
    padding: 24px;
    border-radius: 16px;
    background: var(--surface);
    color: var(--ink);
  }

  .item__text {
    max-width: 34em;
  }

  .item__dl,
  .item__ul {
    display: grid;
    gap: 10px;
    margin: 0.9em 0 0;
    padding: 0;
  }

  .item__dl dt {
    font-weight: 700;
  }

  .item__dl dd {
    margin: 0;
    color: var(--ink-soft);
  }

  .item__ul {
    padding-left: 1.4em;
  }

  .item__dl + p,
  .item__ul + p {
    margin-top: 0.9em;
  }

  /* 開閉の動きはスクリプトで付ける。開いている間は、中身が上から順に浮かんで出る */
  .item__body > * {
    transition:
      opacity 400ms ease calc(var(--n, 0) * 70ms + 120ms),
      translate 500ms cubic-bezier(0.2, 0.8, 0.2, 1) calc(var(--n, 0) * 70ms + 120ms);
  }

  .item__more.is-entering .item__body > * {
    opacity: 0;
    translate: 0 20px;
    transition: none;
  }

  /* 広い画面では中央の線をはさんで左右交互に置く */
  @media (min-width: 900px) {
    .item {
      width: 50%;
      padding: 0 0 72px 56px;
    }

    .item[data-side='left'] {
      padding: 0 56px 72px 0;
      text-align: right;
    }

    .item[data-side='right'] {
      margin-left: 50%;
    }

    .item[data-side='left'] .item__node {
      left: auto;
      right: -10px;
    }

    .item[data-side='right'] .item__node {
      left: -10px;
    }

    .item__card::before {
      left: -46px;
      width: 40px;
    }

    .item[data-side='left'] .item__card::before {
      left: auto;
      right: -46px;
    }

    .item[data-side='left'] .item__date,
    .item[data-side='left'] .item__counters {
      justify-content: flex-end;
    }

    .item[data-side='left'] .item__head,
    .item[data-side='left'] .item__tool {
      flex-direction: row-reverse;
    }

    .item[data-side='left'] .item__body {
      text-align: left;
    }

    .item[data-side='left'] .item__text {
      margin-left: auto;
    }

    /* 前の項目の下半分と高さを重ね、左右が互い違いに並んで見えるようにする */
    .item + .item {
      margin-top: -120px;
    }

    .item__head {
      --thumb: 88px;
    }

    .item__m,
    .item__d {
      font-size: 72px;
    }

    .item__dot {
      font-size: 48px;
    }

    .item:not([data-first='true']) .item__d {
      font-size: 36px;
    }

    .item:not([data-first='true']) .item__node {
      top: 8px;
    }

    .item:not([data-first='true']) .item__card::before {
      top: 17px;
    }
  }
</style>

<script>
  // スクロールで画面に入った項目に印を付ける。一度出したら戻さない
  const seen = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        e.target.classList.add('is-in');
        seen.unobserve(e.target);
      }
    },
    { rootMargin: '0px 0px -10% 0px' },
  );
  document.querySelectorAll('[data-reveal]').forEach((el) => seen.observe(el));

  // 「くわしく読む」の開閉。高さを伸び縮みさせ、開くときは中身を順に浮かばせる。
  // details の素の開閉は一瞬で切り替わるので、押されたら止めて自分で動かす
  const EASE = 'cubic-bezier(0.2, 0.8, 0.2, 1)';
  for (const more of document.querySelectorAll<HTMLDetailsElement>('[data-more]')) {
    const summary = more.querySelector('summary')!;
    const body = more.querySelector<HTMLElement>('.item__body')!;
    [...body.children].forEach((c, i) => (c as HTMLElement).style.setProperty('--n', String(i)));
    let run: Animation | null = null;
    // 古いブラウザは動きの中の overflow を無視するので、動いている間だけ要素に付ける
    const done = () => {
      run = null;
      body.style.overflow = '';
    };

    summary.addEventListener('click', (ev) => {
      ev.preventDefault();
      const from = run ? body.getBoundingClientRect().height : null;
      run?.cancel();
      done();
      body.style.overflow = 'clip';
      const closing = more.open && !more.classList.contains('is-closing');
      if (closing) {
        more.classList.add('is-closing');
        const h = from ?? body.getBoundingClientRect().height;
        run = body.animate(
          [
            { height: `${h}px`, opacity: 1 },
            { height: '0px', opacity: 0 },
          ],
          { duration: 360, easing: EASE },
        );
        run.onfinish = () => {
          more.open = false;
          more.classList.remove('is-closing');
          done();
        };
        return;
      }
      more.classList.remove('is-closing');
      more.classList.add('is-entering');
      more.open = true;
      const h = body.getBoundingClientRect().height;
      body.getBoundingClientRect();
      more.classList.remove('is-entering');
      run = body.animate(
        [
          { height: `${from ?? 0}px` },
          { height: `${h}px` },
        ],
        { duration: 520, easing: EASE },
      );
      run.onfinish = done;
    });
  }
</script>
