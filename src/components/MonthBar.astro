---
// 上に固定する月の色帯。読んでいる月の帯が太くなり、作ったものが無い月は灰色で残す
interface Props {
  months: number[];
}
const { months } = Astro.props;
// 4月から、11月か作ったものがある最後の月まで。12月の節を原稿に足せば12月の列も出る
const last = Math.max(11, ...months);
const all = Array.from({ length: last - 3 }, (_, i) => i + 4);
---
<nav class="bar" aria-label="月ごとに移動">
  <ol class="bar__list">
    {all.map((m) =>
      months.includes(m) ? (
        <li class="bar__item" data-month={m}>
          <a class="bar__link" href={`#m${m}`} data-bar={m}>
            <span class="bar__seg"></span>
            <span class="bar__label">{m}月</span>
          </a>
        </li>
      ) : (
        <li class="bar__item is-empty">
          <span class="bar__link">
            <span class="bar__seg"></span>
            <span class="bar__label">{m}月<span class="sr-only">（作ったものは無し）</span></span>
          </span>
        </li>
      ),
    )}
  </ol>
</nav>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: 20;
    padding: 10px 20px 6px;
    background: rgb(255 255 255 / 0.92);
    backdrop-filter: blur(8px);
  }

  .bar__list {
    display: flex;
    gap: 4px;
    width: min(100%, 1200px);
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  .bar__item {
    flex: 1;
  }

  .bar__link {
    display: grid;
    gap: 4px;
    color: var(--ink-soft);
    text-decoration: none;
  }

  /* 太くなる分の高さを先に取っておき、見た目だけ縮める。高さそのものを変えると、
     月が切り替わる途中で古い帯と新しい帯がどちらも細くなり、白い帯の高さが揺れる */
  .bar__seg {
    display: block;
    height: 12px;
    background: var(--c);
    opacity: 0.7;
    scale: 1 0.5;
    transform-origin: top;
    transition: scale 300ms cubic-bezier(0.2, 0.8, 0.2, 1), opacity 300ms;
  }

  .is-empty .bar__seg {
    background: var(--empty);
    opacity: 1;
  }

  .bar__label {
    font-family: var(--num);
    font-size: 12px;
    font-weight: 500;
    line-height: 1.2;
    text-align: center;
    transition: color 300ms;
  }

  .is-empty .bar__label {
    color: #6b7280;
  }

  a.bar__link:hover .bar__seg {
    opacity: 1;
  }

  .bar__link[aria-current='true'] .bar__seg {
    scale: 1;
    opacity: 1;
  }

  .bar__link[aria-current='true'] .bar__label {
    color: var(--ci);
    font-weight: 600;
  }

  @media (min-width: 768px) {
    .bar__label {
      font-size: 14px;
    }
  }
</style>

<script>
  const links = new Map<number, HTMLElement>();
  document.querySelectorAll<HTMLElement>('[data-bar]').forEach((el) => links.set(Number(el.dataset.bar), el));
  let current = 0;

  const show = (month: number) => {
    if (month === current) return;
    current = month;
    links.forEach((el, m) => el.setAttribute('aria-current', String(m === month)));
  };

  // 画面の上から3分の1あたりを横切る細い帯に入った月を「今の月」とする
  const sections = [...document.querySelectorAll<HTMLElement>('.tl-month[data-month]')];
  const observer = new IntersectionObserver(
    (entries) => {
      for (const e of entries) if (e.isIntersecting) show(Number((e.target as HTMLElement).dataset.month));
    },
    { rootMargin: '-33% 0px -66% 0px' },
  );
  sections.forEach((s) => observer.observe(s));
</script>
