---
// アドベントカレンダーの前後の記事。同時に開いている3つの企画を並べる。
// この記事の企画（mine）は前の日と次の日、ほかの2つは前の日・同じ日・次の日。中身は src/data/advent.json に書く。
// 担当者・題・リンクがそろうと押せる札になる。担当者だけなら「準備中」、担当者もいなければ「まだ空いている日」と出す
import advent from '../data/advent.json';

interface Entry {
  date: string;
  author: string;
  title: string;
  url: string;
}
interface Calendar {
  name: string;
  url: string;
  mine?: boolean;
  entries: Entry[];
}

const calendars = advent.calendars as Calendar[];
const dayNum = (iso: string) => Number(iso.split('-')[2]);
const today = dayNum(advent.day);
const sideOf = (iso: string) => (dayNum(iso) < today ? '前の日' : dayNum(iso) > today ? '次の日' : '同じ日');
const dayOf = (iso: string) => {
  const [, m, d] = iso.split('-').map(Number);
  return { short: `${m}.${String(d).padStart(2, '0')}`, long: `${m}月${d}日` };
};
---
<nav class="advent" aria-labelledby="advent-head">
  <h2 class="advent__head" id="advent-head">アドベントカレンダーの前後の記事</h2>
  {calendars.map((cal, ci) => (
    <section class="advent__cal" aria-labelledby={`advent-cal-${ci}`}>
      <h3 class="advent__name" id={`advent-cal-${ci}`}>
        <a href={cal.url}>{cal.name}</a>
        {cal.mine && <span class="advent__mine">この記事の企画</span>}
      </h3>
      <ul class="advent__list" style={`--n: ${cal.entries.length}`}>
        {cal.entries.map((entry) => {
          const day = dayOf(entry.date);
          const ready = entry.author && entry.title && entry.url;
          const body = (
            <>
              <span class="advent__side">{sideOf(entry.date)}</span>
              <span class="advent__date"><span aria-hidden="true">{day.short}</span><span class="sr-only">{day.long}</span></span>
              {ready ? (
                <span class="advent__title">{entry.title}</span>
              ) : (
                <span class="advent__title advent__title--wait">{entry.author ? '準備中' : 'まだ空いている日'}</span>
              )}
              {entry.author && <span class="advent__author">{entry.author}</span>}
            </>
          );
          return <li class="advent__item">{ready ? <a class="advent__card" href={entry.url}>{body}</a> : <div class="advent__card">{body}</div>}</li>;
        })}
      </ul>
    </section>
  ))}
</nav>

<style>
  .advent {
    display: grid;
    gap: 40px;
    width: min(100% - 40px, 960px);
    margin: 0 auto;
    padding: 72px 0 24px;
  }

  .advent__head {
    margin: 0;
    text-align: center;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .advent__cal {
    display: grid;
    gap: 14px;
  }

  .advent__name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
    margin: 0;
    font-size: 15px;
    font-weight: 700;
    line-height: 1.6;
  }

  /* 押せる高さを24px以上にする（WCAG 2.5.8） */
  .advent__name a {
    padding-block: 3px;
    color: var(--ink);
    text-underline-offset: 0.2em;
  }

  .advent__mine {
    padding: 0 10px;
    border-radius: 999px;
    background: var(--ink);
    color: #fff;
    font-size: 12px;
    line-height: 1.8;
  }

  .advent__list {
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .advent__card {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas:
      'side date'
      'title title'
      'author author';
    align-items: baseline;
    gap: 4px 12px;
    height: 100%;
    padding: 16px 18px;
    border: 2px solid var(--ink);
    border-radius: 12px;
    color: var(--ink);
    text-decoration: none;
  }

  a.advent__card {
    transition: background-color 150ms, color 150ms;
  }

  a.advent__card:hover {
    background: var(--ink);
    color: #fff;
  }

  div.advent__card {
    border-style: dashed;
    border-color: var(--ink-soft);
  }

  .advent__side {
    grid-area: side;
    font-size: 13px;
    font-weight: 700;
  }

  .advent__date {
    grid-area: date;
    justify-self: end;
    font-family: var(--num);
    font-size: 24px;
    font-weight: 500;
    line-height: 1;
  }

  .advent__title {
    grid-area: title;
    margin-top: 6px;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.5;
  }

  .advent__title--wait {
    color: var(--ink-soft);
  }

  .advent__author {
    grid-area: author;
    font-size: 14px;
  }

  @media (max-width: 599px) {
    .advent__list {
      grid-template-columns: 1fr;
    }
  }
</style>
