---
// 締めのエンドロール。画面に入ると、作った物を作った順に流し、最後に作った人の名前と作った数で止まる。
// 自動で動く文なので、止める・もう一度流すボタンを付ける（5秒を超えて動くものは止められるようにする）
interface Tool {
  name: string;
  month: number;
  day: number;
}
interface Props {
  tools: Tool[];
}
const { tools } = Astro.props;
const credits = [
  ['企画・注文', 'がーさん'],
  ['制作', 'Claude'],
  ['書体', 'Noto Sans JP／Oswald'],
  ['アイコン', 'Lucide'],
];
---
<section class="roll" aria-labelledby="roll-head" data-endroll>
  <div class="roll__frame" data-roll-frame>
    <div class="roll__list" data-roll-list>
      <h2 class="roll__head" id="roll-head">今年つくったもの</h2>
      <dl class="roll__rows">
        {tools.map((t) => (
          <div class="roll__row">
            <dt class="roll__date"><span aria-hidden="true">{t.month}.{String(t.day).padStart(2, '0')}</span><span class="sr-only">{t.month}月{t.day}日</span></dt>
            <dd class="roll__name">{t.name}</dd>
          </div>
        ))}
      </dl>
      <dl class="roll__rows roll__rows--credit">
        {credits.map(([role, who]) => (
          <div class="roll__row">
            <dt class="roll__role">{role}</dt>
            <dd class="roll__name">{who}</dd>
          </div>
        ))}
      </dl>
      <div class="roll__end" data-roll-end>
        <p class="roll__year">2026</p>
        <p class="roll__total"><span class="roll__num">{tools.length}</span><span class="roll__unit">こ作った</span></p>
        <p class="roll__fin">おわり</p>
      </div>
    </div>
  </div>
  <button type="button" class="roll__ctl" data-roll-ctl hidden>止める</button>
</section>

<style>
  .roll {
    position: relative;
    background: var(--ink);
    color: #fff;
  }

  .roll__frame {
    position: relative;
    padding: 96px 20px;
  }

  .roll__list {
    display: grid;
    justify-items: center;
    gap: 72px;
    width: min(100%, 720px);
    margin: 0 auto;
  }

  .roll__head {
    margin: 0;
    font-size: clamp(22px, 4vw, 30px);
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  /* 映画の終わりの字幕と同じく、中央の溝をはさんで左に役割（日付）、右に名前 */
  .roll__rows {
    display: grid;
    gap: 18px;
    width: 100%;
    margin: 0;
  }

  .roll__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 28px;
    align-items: baseline;
  }

  .roll__date,
  .roll__role {
    text-align: right;
  }

  .roll__date {
    font-family: var(--num);
    font-size: 22px;
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .roll__role {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .roll__name {
    margin: 0;
    font-size: clamp(16px, 2.6vw, 20px);
    font-weight: 700;
    line-height: 1.5;
  }

  .roll__rows--credit .roll__name {
    font-size: clamp(18px, 3vw, 24px);
  }

  .roll__end {
    display: grid;
    justify-items: center;
    gap: 8px;
    padding-top: 48px;
    text-align: center;
  }

  .roll__year {
    font-family: var(--num);
    font-size: 28px;
    font-weight: 500;
    letter-spacing: 0.3em;
    line-height: 1;
  }

  .roll__total {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  .roll__num {
    font-family: var(--num);
    font-size: clamp(120px, 26vw, 200px);
    font-weight: 600;
    line-height: 1;
  }

  .roll__unit {
    font-size: 20px;
    font-weight: 700;
  }

  .roll__fin {
    margin-top: 32px;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.5em;
  }

  /* スクリプトが動くときだけ、枠を画面の高さに固定して中で流す。上下の端は帯の色へ溶かす */
  :global(.js) .roll__frame {
    height: min(100svh, 900px);
    padding: 0 20px;
    overflow: hidden;
    mask-image: linear-gradient(transparent, #000 14%, #000 86%, transparent);
  }

  :global(.js) .roll__list {
    position: absolute;
    top: 0;
    right: 20px;
    left: 20px;
    translate: 0 var(--y, 100%);
    will-change: translate;
  }

  .roll__ctl {
    position: absolute;
    right: 20px;
    bottom: 20px;
    min-width: 96px;
    min-height: 44px;
    padding: 0 18px;
    border: 2px solid #fff;
    border-radius: 999px;
    background: var(--ink);
    color: #fff;
    font: inherit;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition: background-color 150ms, color 150ms;
  }

  .roll__ctl:hover {
    background: #fff;
    color: var(--ink);
  }

  .roll__ctl:focus-visible {
    outline-color: #fff;
  }
</style>

<script>
  // 1秒に流す長さ。映画の字幕くらいの速さ
  const SPEED = 80;

  for (const roll of document.querySelectorAll<HTMLElement>('[data-endroll]')) {
    const frame = roll.querySelector<HTMLElement>('[data-roll-frame]')!;
    const list = roll.querySelector<HTMLElement>('[data-roll-list]')!;
    const end = roll.querySelector<HTMLElement>('[data-roll-end]')!;
    const ctl = roll.querySelector<HTMLButtonElement>('[data-roll-ctl]')!;
    let run: Animation | null = null;

    // 止まる所は「おわり」の塊が枠の真ん中に来る位置
    const stopAt = () => frame.clientHeight / 2 - (end.offsetTop + end.offsetHeight / 2);
    // 流し始めの位置。見出しが枠の下のほうに見えている所から始め、待ち時間を作らない
    const startAt = () => frame.clientHeight * 0.72;
    list.style.translate = `0 ${startAt()}px`;

    const play = () => {
      run?.cancel();
      const start = startAt();
      const stop = stopAt();
      run = list.animate([{ translate: `0 ${start}px` }, { translate: `0 ${stop}px` }], {
        duration: ((start - stop) / SPEED) * 1000,
        easing: 'cubic-bezier(0.2, 0.25, 0.2, 1)',
        fill: 'forwards',
      });
      ctl.hidden = false;
      ctl.textContent = '止める';
      run.onfinish = () => (ctl.textContent = 'もう一度流す');
    };

    // 流し終えた後に画面の高さが変わったら、「おわり」の塊を枠の真ん中に置き直す
    window.addEventListener('resize', () => {
      if (!run) list.style.translate = `0 ${startAt()}px`;
      if (run?.playState !== 'finished') return;
      run.cancel();
      run = list.animate([{ translate: `0 ${stopAt()}px` }], { duration: 0, fill: 'forwards' });
      run.onfinish = null;
    });

    ctl.addEventListener('click', () => {
      if (!run || run.playState === 'finished') return play();
      if (run.playState === 'paused') {
        run.play();
        ctl.textContent = '止める';
      } else {
        run.pause();
        ctl.textContent = '続きを流す';
      }
    });

    // 枠が少しでも見えたら流し始める。一度流したら、あとはボタンで流し直す
    const io = new IntersectionObserver(
      ([e]) => {
        if (!e.isIntersecting) return;
        io.disconnect();
        play();
      },
      { threshold: 0.15 },
    );
    io.observe(frame);
  }
</script>
