---
// 締めのエンドロール。映画の終わりと同じく、黒い画面いっぱいに題の札を出し、作った物を作った順に一定の速さで流す。
// 最後の「2026 / 18こ作った」の札だけが真ん中で止まり、その上の行はそのまま上へ抜けていく。
// 自動で動く文なので、止める・もう一度流すボタンを付ける（5秒を超えて動くものは止められるようにする）
interface Tool {
  name: string;
  month: number;
  day: number;
}
interface Props {
  tools: Tool[];
}
const { tools } = Astro.props;
// 映画の終わりと同じく、作った物を「出演」として流し、そのあとにスタッフ・スペシャルサンクス・制作委員会を大げさに並べる
const staff = [
  ['監督・主演・注文', 'がーさん'],
  ['制作', 'Claude'],
  ['記録', 'Worklog'],
  ['書体', 'Noto Sans JP／Oswald'],
  ['アイコン', 'Lucide'],
];
const thanks = [
  '黒川晝車',
  '浦下拓巳',
  'その他の株式会社Pedanticメンバー',
  '壁',
  '約3万問のクイズとそれらを作問したクイズプレイヤーたち',
  '全国の動物園と水族館',
  'この世を生きるすべてのいきものたち',
  'フラの仲間たち',
];
const committee = ['ゆる民俗学・音楽学ラジオ 非公式', 'Advent Calendar 2026', '制作委員会'];
---
<section class="roll" aria-labelledby="roll-head" data-endroll>
  <div class="roll__frame" data-roll-frame>
    <div class="roll__list" data-roll-list>
      <h2 class="roll__head" id="roll-head" data-roll-head>2026年につくったもの</h2>
      <p class="roll__label">出演</p>
      <dl class="roll__rows">
        {tools.map((t) => (
          <div class="roll__row">
            <dt class="roll__date"><span aria-hidden="true">{t.month}.{String(t.day).padStart(2, '0')}</span><span class="sr-only">{t.month}月{t.day}日</span></dt>
            <dd class="roll__name">{t.name}</dd>
          </div>
        ))}
      </dl>
      <dl class="roll__staff">
        {staff.map(([role, who]) => (
          <div class="roll__credit">
            <dt class="roll__role">{role}</dt>
            <dd class="roll__who">{who}</dd>
          </div>
        ))}
      </dl>
      <div class="roll__credit">
        <p class="roll__role">スペシャルサンクス</p>
        <ul class="roll__thanks">{thanks.map((t) => <li>{t}</li>)}</ul>
      </div>
      <div class="roll__credit">
        <p class="roll__role">制作</p>
        <p class="roll__committee">{committee.map((t) => <span>{t}</span>)}</p>
      </div>
    </div>
    <div class="roll__end" data-roll-end>
      <p class="roll__year">2026</p>
      <p class="roll__total"><span class="roll__num">{tools.length}</span><span class="roll__unit">こ作った</span></p>
      <p class="roll__fin" data-roll-fin>おわり</p>
    </div>
  </div>
  <button type="button" class="roll__ctl" data-roll-ctl hidden>止める</button>
</section>

<style>
  .roll {
    position: relative;
    background: #000;
    color: #fff;
    /* 近くまでスクロールしたら、黒い画面がブラウザにぴったり収まる所で止める。
       ページ全体の scroll-padding-top（上の月の帯の分）をここでは打ち消す。月の帯はこの手前で消えるため */
    scroll-snap-align: start;
    scroll-margin-top: -72px;
  }

  .roll__frame {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 96px;
    padding: 96px 20px;
  }

  .roll__list {
    display: grid;
    justify-items: center;
    gap: 80px;
    width: min(100%, 720px);
  }

  .roll__head {
    margin: 0;
    font-size: clamp(24px, 4.4vw, 36px);
    font-weight: 700;
    letter-spacing: 0.24em;
    text-indent: 0.24em;
  }

  /* 出演の欄。映画の終わりの字幕と同じく、溝をはさんで左に日付、右に名前を置く。
     溝を画面の真ん中に置くと、日付が短く名前が長いぶん塊が右へ寄って見える。
     日付と名前の塊ごと真ん中に置き、目で見て真ん中に来るようにする */
  .roll__rows {
    display: grid;
    grid-template-columns: auto minmax(0, auto);
    justify-content: center;
    gap: 14px 28px;
    margin: 0;
  }

  .roll__row {
    display: contents;
  }

  /* 見出しの「出演」から名前までの間は、スタッフ以降の役割と名前の間（10px）にそろえる。並びの間は80px */
  .roll__label {
    margin: 0 0 -70px;
    color: #a3a3a3;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-indent: 0.16em;
  }

  .roll__date {
    align-self: baseline;
    color: #a3a3a3;
    text-align: right;
  }

  .roll__date {
    font-family: var(--num);
    font-size: 18px;
    font-weight: 500;
    letter-spacing: 0.08em;
  }

  .roll__name {
    align-self: baseline;
    margin: 0;
    font-size: clamp(15px, 2.4vw, 19px);
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: 0.04em;
  }

  /* スタッフから先は、役割を上に小さく、名前を下に大きく、1つずつ真ん中に積む */
  .roll__staff {
    display: grid;
    gap: 44px;
    margin: 0;
  }

  .roll__credit {
    display: grid;
    justify-items: center;
    gap: 10px;
    text-align: center;
  }

  .roll__role {
    margin: 0;
    color: #a3a3a3;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-indent: 0.16em;
  }

  .roll__who {
    margin: 0;
    font-size: clamp(18px, 3vw, 24px);
    font-weight: 700;
    line-height: 1.4;
  }

  .roll__thanks {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: clamp(15px, 2.4vw, 19px);
    font-weight: 500;
  }

  .roll__committee {
    display: grid;
    gap: 4px;
    margin: 0;
    font-size: clamp(18px, 3vw, 24px);
    font-weight: 700;
    line-height: 1.4;
  }

  .roll__end {
    display: grid;
    justify-items: center;
    gap: 8px;
    text-align: center;
  }

  .roll__year {
    font-family: var(--num);
    font-size: 24px;
    font-weight: 500;
    letter-spacing: 0.4em;
    text-indent: 0.4em;
    line-height: 1;
  }

  .roll__total {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  .roll__num {
    font-family: var(--num);
    font-size: clamp(120px, 26vw, 200px);
    font-weight: 600;
    line-height: 1;
  }

  .roll__unit {
    font-size: 20px;
    font-weight: 700;
  }

  .roll__fin {
    margin-top: 32px;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.6em;
    text-indent: 0.6em;
  }

  /* スクリプトが動くときだけ、枠をブラウザの高さいっぱいにして中で流す。映画と同じく上下の端で切る */
  :global(.js) .roll__frame {
    display: block;
    height: 100svh;
    padding: 0;
    overflow: hidden;
  }

  :global(.js) .roll__list,
  :global(.js) .roll__end {
    position: absolute;
    top: 0;
    right: 20px;
    left: 20px;
    margin: 0 auto;
    will-change: translate;
  }

  /* 流し始めるまでは何も見せない。最初の位置はスクリプトが入れる */
  :global(.js) .roll__head,
  :global(.js) .roll__fin {
    opacity: 0;
  }

  :global(.js) .roll__list {
    width: auto;
    max-width: 720px;
    translate: 0 100svh;
  }

  :global(.js) .roll__end {
    translate: 0 200svh;
  }

  .roll__ctl {
    position: absolute;
    right: 20px;
    bottom: 20px;
    min-width: 96px;
    min-height: 44px;
    padding: 0 18px;
    border: 2px solid #fff;
    border-radius: 999px;
    background: #000;
    color: #fff;
    font: inherit;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition: background-color 150ms, color 150ms;
  }

  @media (hover: hover) {
    .roll__ctl:hover {
      background: #fff;
      color: #000;
    }
  }

  .roll__ctl:focus-visible {
    outline-color: #fff;
  }
</style>

<script>
  // 1秒に流す長さ。映画の字幕と同じく、最初から最後まで同じ速さで流す
  const SPEED = 120;
  // 題の札が浮かび上がる時間と、流れ出すまで止まって見せる時間
  const FADE = 700;
  const HOLD = 1300;

  for (const roll of document.querySelectorAll<HTMLElement>('[data-endroll]')) {
    const frame = roll.querySelector<HTMLElement>('[data-roll-frame]')!;
    const list = roll.querySelector<HTMLElement>('[data-roll-list]')!;
    const head = roll.querySelector<HTMLElement>('[data-roll-head]')!;
    const end = roll.querySelector<HTMLElement>('[data-roll-end]')!;
    const fin = roll.querySelector<HTMLElement>('[data-roll-fin]')!;
    const cast = roll.querySelector<HTMLElement>('.roll__rows')!;
    const ctl = roll.querySelector<HTMLButtonElement>('[data-roll-ctl]')!;
    let runs: Animation[] = [];
    let played = false;

    // 出演欄を目で見て真ん中に置く。外枠の真ん中に置くと、一番長い名前に引っぱられて大半の行が左に寄って見え、
    // 行ごとの真ん中の平均に置くと、長い名前が右へはみ出して見える。その中間に置き、枠からは出さない
    const centerCast = () => {
      cast.style.translate = '';
      const box = cast.getBoundingClientRect();
      const area = list.getBoundingClientRect();
      const dates = [...cast.querySelectorAll('.roll__date [aria-hidden]')].map((e) => e.getBoundingClientRect().left);
      const ends = [...cast.querySelectorAll('.roll__name')].map((e) => {
        const r = document.createRange();
        r.selectNodeContents(e);
        return r.getBoundingClientRect().right;
      });
      const left = Math.min(...dates);
      const right = Math.max(...ends);
      const rowMid = dates.reduce((sum, d, i) => sum + (d + ends[i]) / 2, 0) / dates.length;
      const want = area.left + area.width / 2 - ((left + right) / 2 + rowMid) / 2;
      const shift = Math.max(area.left - box.left, Math.min(area.right - box.right, want));
      cast.style.translate = `${Math.round(shift)}px 0`;
    };

    // 位置はすべて枠の上端からの距離（px）
    const measure = () => {
      centerCast();
      const h = frame.clientHeight;
      // 題の札は枠の真ん中から始め、その下の行は枠の下の端のすぐ外に置く
      head.style.marginBottom = '0px';
      const gap = parseFloat(getComputedStyle(list).rowGap);
      head.style.marginBottom = `${Math.max(0, h / 2 - head.offsetHeight / 2 - gap)}px`;
      const listStart = h / 2 - head.offsetHeight / 2;
      const listOut = -list.offsetHeight;
      // 締めの札は最後の行の少し後ろを付いてきて、真ん中に来たら止まる
      const endStart = listStart + list.offsetHeight + h * 0.25;
      const endStop = h / 2 - end.offsetHeight / 2;
      return { listStart, listOut, endStart, endStop };
    };

    const pose = (listY: number, endY: number, shown: boolean) => {
      list.style.translate = `0 ${listY}px`;
      end.style.translate = `0 ${endY}px`;
      head.style.opacity = fin.style.opacity = shown ? '1' : '0';
    };

    const finished = () => runs.length > 0 && runs.every((a) => a.playState === 'finished');

    const play = () => {
      runs.forEach((a) => a.cancel());
      const { listStart, listOut, endStart, endStop } = measure();
      pose(listStart, endStart, false);
      const listTime = ((listStart - listOut) / SPEED) * 1000;
      const endTime = ((endStart - endStop) / SPEED) * 1000;
      const total = Math.max(listTime, endTime);
      const lead = FADE + HOLD;
      const opts = { delay: lead, duration: total, fill: 'forwards' } as const;
      runs = [
        head.animate([{ opacity: 0 }, { opacity: 1 }], { duration: FADE, fill: 'forwards' }),
        list.animate([{ translate: `0 ${listStart}px` }, { translate: `0 ${listStart - (SPEED * total) / 1000}px` }], opts),
        // 締めの札は行と同じ速さで上がり、真ん中に来たらそこで止まる。行のほうは止まらずに上へ抜ける
        end.animate(
          [
            { translate: `0 ${endStart}px` },
            { translate: `0 ${endStop}px`, offset: endTime / total },
            { translate: `0 ${endStop}px` },
          ],
          opts,
        ),
        fin.animate([{ opacity: 0 }, { opacity: 1 }], { delay: lead + endTime + 600, duration: 900, fill: 'forwards' }),
      ];
      ctl.hidden = false;
      ctl.textContent = '止める';
      Promise.all(runs.map((a) => a.finished))
        .then(() => (ctl.textContent = 'もう一度流す'))
        .catch(() => {});
    };

    // 画面の高さが変わったら置き直す。流し終えた後なら、締めの札を枠の真ん中に置き直す
    const relayout = () => {
      if (!played) {
        const { listStart, endStart } = measure();
        return pose(listStart, endStart, false);
      }
      if (runs.length > 0 && !finished()) return;
      runs.forEach((a) => a.cancel());
      runs = [];
      const { listOut, endStop } = measure();
      pose(listOut, endStop, true);
      ctl.textContent = 'もう一度流す';
    };
    relayout();
    window.addEventListener('resize', relayout);

    ctl.addEventListener('click', () => {
      if (runs.length === 0 || finished()) return play();
      // 終わった動き（題のフェードなど）に play() をかけると頭から再生し直すので、終わっていないものだけを止め・動かす
      const live = runs.filter((a) => a.playState !== 'finished');
      if (live.some((a) => a.playState === 'paused')) {
        live.forEach((a) => a.play());
        ctl.textContent = '止める';
      } else {
        live.forEach((a) => a.pause());
        ctl.textContent = '続きを流す';
      }
    });

    // 枠がほぼ画面に入ったら流し始める。題の札を見落とさないよう、半分以上見えてから。一度流したら、あとはボタンで流し直す
    const io = new IntersectionObserver(
      ([e]) => {
        if (!e.isIntersecting) return;
        io.disconnect();
        played = true;
        play();
      },
      { threshold: 0.6 },
    );
    io.observe(frame);
  }
</script>
