---
import '@fontsource/oswald/500.css';
import '@fontsource/oswald/600.css';
import '@fontsource-variable/noto-sans-jp';
import '../styles/global.css';
import timeline from '../data/timeline.json';
import extrasList from '../data/extras.json';
import MonthBar from '../components/MonthBar.astro';
import TimelineItem from '../components/TimelineItem.astro';
import Shot from '../components/Shot.astro';
import HeroShelf from '../components/HeroShelf.astro';
import Finale from '../components/Finale.astro';

type Extra = { id: string; match: string; icon?: string; lead?: string; counter?: { value: string; unit: string }; demo?: string; noShot?: boolean };
type Entry = { date: string; month: number; day: number; title: string; paragraphs: string[]; hasImage: boolean; tools: string[] };
type TextSection = { type: 'text'; heading: string; paragraphs: string[]; hasImage: boolean };
type MonthSection = { type: 'month'; heading: string; month: number; entries: Entry[] };

const extras = new Map((extrasList as Extra[]).map((x) => [x.id, x]));
const sections = timeline.sections as (TextSection | MonthSection)[];
const intro = sections[0] as TextSection;
const rest = sections.slice(1);
const months = rest.filter((s): s is MonthSection => s.type === 'month').map((s) => s.month);
const counts = Object.fromEntries((rest.filter((s) => s.type === 'month') as MonthSection[]).map((s) => [s.month, s.entries.reduce((n, e) => n + e.tools.length, 0)]));
const firstMonth = rest.findIndex((s) => s.type === 'month');
const lastMonth = rest.length - 1 - [...rest].reverse().findIndex((s) => s.type === 'month');
const before = rest.slice(0, firstMonth);
const monthSections = rest.slice(firstMonth, lastMonth + 1) as MonthSection[];
const after = rest.slice(lastMonth + 1);

// 左右は全項目を通して交互にする
let k = 0;
const side = () => (k++ % 2 === 0 ? 'left' : 'right');
const total = extras.size;
const anchorOf = (e: Entry) => `i-${e.tools[0]}`;
const shelf = monthSections.flatMap((s) => s.entries.flatMap((e) => e.tools.map((id) => ({ id, name: extras.get(id)!.match, icon: extras.get(id)!.icon, month: e.month, day: e.day, anchor: anchorOf(e) }))));
// 題は「〜を」の後ろで2行に分ける。原稿の題に「を」が無ければそのまま1つの塊で出す
const titleParts = timeline.title.includes('を') ? [timeline.title.slice(0, timeline.title.indexOf('を') + 1), timeline.title.slice(timeline.title.indexOf('を') + 1)] : [timeline.title];
const description = `Webデザイナーが今年AIに頼んで作ったアプリやページ${total}件を、作った日の順に並べた年表。`;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{timeline.title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={timeline.title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta name="theme-color" content="#ffffff" />
  </head>
  <body>
    <MonthBar months={months} counts={counts} />

    <header class="hero">
      <div class="hero__top">
        <div class="hero__head">
          <p class="hero__year" aria-hidden="true">2026</p>
          <h1 class="hero__title">{titleParts.map((t) => <span>{t}</span>)}</h1>
        </div>
        <div class="hero__chart"><HeroShelf tools={shelf} /></div>
        <div class="hero__body">{intro.paragraphs.map((p) => <p>{p}</p>)}</div>
      </div>
      {intro.hasImage && <div class="cover-shot"><Shot id="tana-overview" alt="つくったもの棚の画面" variant="full" /></div>}
    </header>

    {(before as TextSection[]).map((s) => (
      <section class="note">
        <h2 class="note__head">{s.heading}</h2>
        <div class="note__body">{s.paragraphs.map((p) => <p>{p}</p>)}</div>
      </section>
    ))}

    <main class="tl">
      {monthSections.map((s) => (
        <section class="tl-month" id={`m${s.month}`} data-month={s.month} aria-labelledby={`mh${s.month}`}>
          <div class="tl-month__inner">
            <h2 class="tl-month__head" id={`mh${s.month}`}>
              <span class="tl-month__name"><span class="tl-month__num">{s.month}</span><span class="tl-month__unit">月</span></span>
              <span class="tl-month__count">{counts[s.month]}つ作った</span>
            </h2>
            {s.entries.map((e, i) => (
              <TimelineItem {...e} tools={e.tools.map((id) => extras.get(id)!)} side={side()} first={i === 0} anchor={anchorOf(e)} />
            ))}
          </div>
        </section>
      ))}
    </main>

    {(after as TextSection[]).map((s) => (
      <section class="note">
        <h2 class="note__head">{s.heading}</h2>
        <div class="note__body">{s.paragraphs.map((p) => <p>{p}</p>)}</div>
      </section>
    ))}
    <Finale count={shelf.length} />
    <footer class="foot"><span class="foot__end" aria-hidden="true"></span></footer>
  </body>
</html>

<style>
  /* 月ごとに、その月の色で塗った帯を横いっぱいに敷く */
  .tl-month {
    padding: 88px 0 40px;
    background: var(--c);
    color: var(--on-c);
  }

  .tl-month__inner {
    position: relative;
    width: min(100% - 40px, 1200px);
    margin: 0 auto;
  }

  /* 縦の線。帯の色の上に、白（明るい月は墨）で細く引く */
  .tl-month__inner::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 22px;
    width: 2px;
    background: var(--on-c);
    opacity: 0.5;
  }

  /* 月の見出し。大きな数字で線の頭をふさぐ */
  .tl-month__head {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: fit-content;
    margin: 0 0 40px;
    padding: 0 0 16px;
    background: var(--c);
    line-height: 0.85;
  }

  .tl-month__name {
    display: flex;
    align-items: baseline;
    gap: 4px;
  }

  .tl-month__num {
    font-family: var(--num);
    font-size: clamp(96px, 26vw, 200px);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .tl-month__unit {
    font-size: clamp(24px, 5vw, 36px);
    font-weight: 700;
  }

  .tl-month__count {
    font-size: 14px;
    font-weight: 700;
  }

  @media (min-width: 900px) {
    .tl-month {
      padding-top: 104px;
    }

    .tl-month__inner::before {
      left: calc(50% - 1px);
    }

    .tl-month__head {
      align-items: center;
      margin: 0 auto 64px;
      padding: 0 24px 24px;
      text-align: center;
    }

  }

  .foot {
    padding: 24px 0 96px;
  }
</style>
