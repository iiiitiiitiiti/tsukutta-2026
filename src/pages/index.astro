---
import '@fontsource/oswald/500.css';
import '@fontsource/oswald/600.css';
import '@fontsource-variable/noto-sans-jp';
import '../styles/global.css';
import timeline from '../data/timeline.json';
import extrasList from '../data/extras.json';
import MonthBar from '../components/MonthBar.astro';
import TimelineItem from '../components/TimelineItem.astro';
import Shot from '../components/Shot.astro';
import HeroShelf from '../components/HeroShelf.astro';
import Finale from '../components/Finale.astro';
import AdventNav from '../components/AdventNav.astro';
import advent from '../data/advent.json';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';

type Extra = { id: string; match: string; icon?: string; lead?: string; counter?: { value: string; unit: string }; demo?: string; noShot?: boolean };
type Entry = { date: string; month: number; day: number; title: string; paragraphs: string[]; hasImage: boolean; tools: string[] };
type TextSection = { type: 'text'; heading: string; paragraphs: string[]; hasImage: boolean };
type MonthSection = { type: 'month'; heading: string; month: number; entries: Entry[] };

const extras = new Map((extrasList as Extra[]).map((x) => [x.id, x]));
const sections = timeline.sections as (TextSection | MonthSection)[];
const intro = sections[0] as TextSection;
const rest = sections.slice(1);
const months = rest.filter((s): s is MonthSection => s.type === 'month').map((s) => s.month);
const counts = Object.fromEntries((rest.filter((s) => s.type === 'month') as MonthSection[]).map((s) => [s.month, s.entries.reduce((n, e) => n + e.tools.length, 0)]));
const firstMonth = rest.findIndex((s) => s.type === 'month');
const lastMonth = rest.length - 1 - [...rest].reverse().findIndex((s) => s.type === 'month');
const before = rest.slice(0, firstMonth);
const monthSections = rest.slice(firstMonth, lastMonth + 1) as MonthSection[];
const after = rest.slice(lastMonth + 1);

// 左右は全項目を通して交互にする
let k = 0;
const side = () => (k++ % 2 === 0 ? 'left' : 'right');
const total = extras.size;
const anchorOf = (e: Entry) => `i-${e.tools[0]}`;
const shelf = monthSections.flatMap((s) => s.entries.flatMap((e) => e.tools.map((id) => ({ id, name: extras.get(id)!.match, icon: extras.get(id)!.icon, month: e.month, day: e.day, anchor: anchorOf(e) }))));
// 題は「〜を」の後ろで2行に分ける。原稿の題に「を」が無ければそのまま1つの塊で出す
const titleParts = timeline.title.includes('を') ? [timeline.title.slice(0, timeline.title.indexOf('を') + 1), timeline.title.slice(timeline.title.indexOf('を') + 1)] : [timeline.title];
// 年表の終わりに置く「つづく」。最後の月の次の月を出す。12月まであれば来年へつづく
const lastShown = monthSections.at(-1)!.month;
const nextLabel = lastShown < 12 ? `${lastShown + 1}` : '2027';
const nextText = lastShown < 12 ? `${lastShown + 1}月へつづく` : '来年へつづく';
// この記事が入っているアドベントカレンダーの企画。表紙の題の下に一言で出す
const mine = advent.calendars.find((c) => 'mine' in c && c.mine)!;
const arrowUp = readFileSync(resolve(process.cwd(), 'node_modules/lucide-static/icons/arrow-up.svg'), 'utf8').replace(/<!--[\s\S]*?-->/g, '');
const description = `Webデザイナーが今年AIに頼んで作ったアプリやページ${total}件を、作った日の順に並べた年表。`;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{timeline.title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={timeline.title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body id="top">
    {/* 上の月の帯はこの囲みの中だけで付いてくる。締めのエンドロールに入る手前で止まる */}
    <div class="page">
    <MonthBar months={months} />

    <header class="hero">
      <div class="hero__top">
        <div class="hero__head">
          <p class="hero__year" aria-hidden="true">2026</p>
          <h1 class="hero__title">{titleParts.map((t) => <span>{t}</span>)}</h1>
          <p class="hero__advent">この記事は<a href={mine.url}>{mine.name}</a>の{Number(advent.day.split('-')[2])}日目です。</p>
        </div>
        <div class="hero__chart"><HeroShelf tools={shelf} /></div>
        <div class="hero__body">{intro.paragraphs.map((p) => <p>{p}</p>)}</div>
      </div>
      {intro.hasImage && <div class="cover-shot"><Shot id="tana-overview" alt="つくったもの棚の画面" variant="full" /></div>}
    </header>

    {(before as TextSection[]).map((s) => (
      <section class="note">
        <h2 class="note__head">{s.heading}</h2>
        <div class="note__body">{s.paragraphs.map((p) => <p>{p}</p>)}</div>
      </section>
    ))}

    <main class="tl">
      {monthSections.map((s, i) => (
        <section class="tl-month" id={`m${s.month}`} data-month={s.month} data-single={s.entries.length === 1} aria-labelledby={`mh${s.month}`} style={`--c-next: ${monthSections[i + 1] ? `var(--b${monthSections[i + 1].month})` : 'var(--bg)'}`}>
          <div class="tl-month__inner">
            <h2 class="tl-month__head" id={`mh${s.month}`} data-reveal>
              <span class="tl-month__name"><span class="tl-month__num">{s.month}</span><span class="tl-month__unit">月</span></span>
              <span class="tl-month__count">{counts[s.month]}つ作った</span>
            </h2>
            {s.entries.map((e, i) => (
              <TimelineItem {...e} tools={e.tools.map((id) => extras.get(id)!)} side={side()} first={i === 0} anchor={anchorOf(e)} />
            ))}
          </div>
        </section>
      ))}
      {/* 年表はここで終わりではない。線を点線にして下へ伸ばし、次の月の数字を輪郭だけで置く */}
      <div class="tl-next" data-reveal>
        <div class="tl-next__inner">
          <p class="tl-next__head">
            <span class="tl-next__num" aria-hidden="true">{nextLabel}</span>
            <span class="tl-next__text">{nextText}</span>
          </p>
        </div>
      </div>
    </main>

    {(after as TextSection[]).map((s) => (
      <section class="note">
        <h2 class="note__head">{s.heading}</h2>
        <div class="note__body">{s.paragraphs.map((p) => <p>{p}</p>)}</div>
      </section>
    ))}
    </div>
    <Finale tools={shelf} />
    <AdventNav />
    <footer class="foot">
      <a class="foot__top" href="#top"><span class="foot__icon" aria-hidden="true" set:html={arrowUp} />上に戻る</a>
    </footer>
  </body>
</html>

<style>
  /* 月ごとに、その月の色で塗った帯を横いっぱいに敷く。月の見出しの所はその月の色のまま置き、
     そこから下へ次の月の色へ移していく。帯の境目で色がつながり、季節が移るように見える。
     色は oklch で混ぜる。oklab や sRGB で混ぜると、色相の離れた月どうし（4月の橙と7月の緑など）の
     中ほどで鮮やかさが抜けて濁る。oklch は鮮やかさを保ったまま色相を回すので、間に黄色などが挟まる */
  .tl-month {
    /* 色を変え始める所。月の見出しの箱（上の余白＋大きな数字＋添え書き）の下端より少し下に置く */
    --hold: calc(56px + clamp(96px, 26vw, 200px) * 0.85 + 72px);
    padding: 56px 0 16px;
    background: var(--band) linear-gradient(var(--band) var(--hold), var(--c-next));
    background: var(--band) linear-gradient(in oklch, var(--band) var(--hold), var(--c-next));
    color: var(--on-c);
  }

  /* 最後の月は白へ移す。白には色相が無く、oklch で混ぜると途中に別の色相（薄い紫）が出るので oklab で混ぜる */
  .tl-month:last-of-type {
    background: var(--band) linear-gradient(in oklab, var(--band) var(--hold), var(--c-next));
  }

  /* スマホは左右の余白と、線から項目までを詰めて、開いた中身の幅を広く取る */
  .tl-month__inner {
    position: relative;
    width: min(100% - 32px, 1200px);
    margin: 0 auto;
  }

  /* 縦の線。帯の色の上に、白（明るい月は墨）で細く引く */
  .tl-month__inner::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 14px;
    width: 2px;
    background: var(--on-c);
    opacity: 0.5;
  }

  /* 月の見出し。大きな数字で線の頭をふさぐ */
  .tl-month__head {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: fit-content;
    margin: 0 0 32px;
    padding: 0 0 16px;
    background: var(--band);
    line-height: 0.85;
  }

  .tl-month__name {
    display: flex;
    align-items: baseline;
    gap: 4px;
  }

  .tl-month__num {
    font-family: var(--num);
    font-size: clamp(96px, 26vw, 200px);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .tl-month__unit {
    font-size: clamp(24px, 5vw, 36px);
    font-weight: 700;
  }

  .tl-month__count {
    font-size: 14px;
    font-weight: 700;
  }

  /* 月の数字も、画面に入ったら下からせり上がる */
  .tl-month__name,
  .tl-month__count {
    transition:
      opacity 600ms ease,
      translate 900ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .tl-month__count {
    transition-delay: 200ms;
  }

  :global(.js) .tl-month__head:not(.is-in) .tl-month__name {
    opacity: 0;
    translate: 0 0.5em;
  }

  :global(.js) .tl-month__head:not(.is-in) .tl-month__count {
    opacity: 0;
    translate: 0 12px;
  }

  @media (min-width: 900px) {
    .tl-month {
      --hold: calc(104px + clamp(96px, 26vw, 200px) * 0.85 + 80px);
      padding: 104px 0 40px;
    }

    .tl-month__inner {
      width: min(100% - 40px, 1200px);
    }

    .tl-month__inner::before {
      left: calc(50% - 1px);
    }

    .tl-month__head {
      align-items: center;
      margin: 0 auto 64px;
      padding: 0 24px 24px;
      text-align: center;
    }

    /* 項目が1つだけの月は、月の数字を上に置かず、項目の反対側の空いている所へ並べる */
    /* 月の数字が上に無いぶん区画が短いので、色を移し始める所も早める */
    .tl-month[data-single='true'] {
      --hold: 50%;
    }

    .tl-month[data-single='true'] .tl-month__inner {
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }

    .tl-month[data-single='true'] .tl-month__head {
      grid-row: 1;
      margin: 0;
      padding: 0;
      background: none;
    }

    .tl-month[data-single='true'] :global(.item) {
      grid-row: 1;
      width: auto;
      margin-left: 0;
    }

    .tl-month[data-single='true']:has(:global(.item[data-side='left'])) .tl-month__head {
      grid-column: 2;
      justify-self: start;
      align-items: flex-start;
      padding-left: 56px;
      text-align: left;
    }

    .tl-month[data-single='true']:has(:global(.item[data-side='right'])) .tl-month__head {
      grid-column: 1;
      justify-self: end;
      align-items: flex-end;
      padding-right: 56px;
      text-align: right;
    }

    .tl-month[data-single='true'] :global(.item[data-side='left']) {
      grid-column: 1;
    }

    .tl-month[data-single='true'] :global(.item[data-side='right']) {
      grid-column: 2;
    }
  }

  /* 年表の終わり。最後の月の線の続きを点線で下へ伸ばし、薄れて消える。
     途中に次の月の数字を輪郭だけで置き、まだ作っている途中であることを見せる */
  .tl-next {
    margin-top: -40px;
    padding-bottom: 32px;
  }

  .tl-next__inner {
    position: relative;
    width: min(100% - 32px, 1200px);
    margin: 0 auto;
    padding: 96px 0 160px;
  }

  .tl-next__inner::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 14px;
    width: 2px;
    background: repeating-linear-gradient(to bottom, var(--ink) 0 6px, transparent 6px 14px);
    opacity: 0.5;
    mask-image: linear-gradient(#000 55%, transparent);
    transform-origin: top;
    transition: scale 1400ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  /* 月の見出しと同じ大きさ・同じ置き方。白い地で線の上をふさぐ */
  .tl-next__head {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: fit-content;
    margin: 0;
    padding: 16px 0;
    background: var(--bg);
    line-height: 0.85;
  }

  .tl-next__num {
    font-family: var(--num);
    font-size: clamp(96px, 26vw, 200px);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: transparent;
    -webkit-text-stroke: 2px var(--ink);
  }

  .tl-next__text {
    font-size: 14px;
    font-weight: 700;
  }

  .tl-next__num,
  .tl-next__text {
    transition:
      opacity 600ms ease 500ms,
      translate 900ms cubic-bezier(0.2, 0.8, 0.2, 1) 500ms;
  }

  .tl-next__text {
    transition-delay: 800ms;
  }

  :global(.js) .tl-next:not(.is-in) .tl-next__inner::before {
    scale: 1 0;
  }

  :global(.js) .tl-next:not(.is-in) .tl-next__num {
    opacity: 0;
    translate: 0 0.3em;
  }

  :global(.js) .tl-next:not(.is-in) .tl-next__text {
    opacity: 0;
    translate: 0 12px;
  }

  @media (min-width: 900px) {
    .tl-next__inner {
      width: min(100% - 40px, 1200px);
    }

    .tl-next__inner::before {
      left: calc(50% - 1px);
    }

    .tl-next__head {
      align-items: center;
      margin: 0 auto;
      padding: 24px;
      text-align: center;
    }
  }

  .foot {
    display: grid;
    justify-items: center;
    padding: 40px 20px 96px;
    scroll-snap-align: end;
  }

  .foot__top {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 48px;
    padding: 0 24px;
    border: 2px solid var(--ink);
    border-radius: 999px;
    color: var(--ink);
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    transition: background-color 150ms, color 150ms;
  }

  @media (hover: hover) {
    .foot__top:hover {
      background: var(--ink);
      color: #fff;
    }
  }

  .foot__icon {
    display: grid;
    width: 18px;
  }

  .foot__icon :global(svg) {
    width: 100%;
    height: auto;
    stroke-width: 2.25;
  }
</style>
